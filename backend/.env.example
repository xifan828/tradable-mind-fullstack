# To separate your traces from other application
LANGSMITH_PROJECT=new-agent

# Add API keys for connecting to LLM providers, data sources, and other integrations here

# Quant agent: OpenRouter slug + reasoning effort for the code-writing analyst.
QUANT_AGENT_MODEL=deepseek/deepseek-v4.1-flash
# Optional: low | medium | high. Omit to use the model default.
# QUANT_AGENT_THINKING_LEVEL=medium

# Chart agent: Gemini with native code execution, called through LangChain.
CHART_AGENT_MODEL=gemini-3.8-flash
# Optional: minimal | low | medium | high. Omit to use the model default.
# CHART_AGENT_THINKING_LEVEL=medium
GEMINI_API_KEY=
